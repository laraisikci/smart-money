PORT=8787
CORS_ORIGIN=http://localhost:5173

# SEC EDGAR requires an identifying User-Agent on every request (format: "AppName contact@email").
# Requests without one get 403'd and can trigger a temporary IP block. See:
# https://www.sec.gov/search-filings/edgar-application-programming-interfaces
SEC_USER_AGENT="SmartMoneyDashboard your-email@example.com"

# Optional. Only used by GET /api/news/:ticker (the single-ticker on-demand fetch behind each
# ticker's detail view) — tried first, falling back to the free Yahoo RSS feed if unset, quota-
# exhausted, or erroring. Free tier is 100 requests/day, non-commercial use only, nowhere near
# enough to cover the full tracked universe — NOT used by the bulk GET /api/news endpoint that
# powers the Conviction score and card badges across all tickers; that stays on Yahoo RSS, which
# has no such quota. Get a key at https://gnews.io
GNEWS_API_KEY=

# Optional. Powers the Analyst Consensus section (recommendation distribution + price target) —
# see finnhubClient.ts. Without it, that section just doesn't render. Free tier, no credit card:
# https://finnhub.io/register — reliable for US-listed tickers, coverage for European exchanges
# on the free plan is inconsistent.
FINNHUB_API_KEY=
